---
const currentYear = new Date().getFullYear();

const contactLinks = [
  { href: "https://github.com/luishutterli", label: "GitHub", external: true },
  { href: "https://linkedin.com/in/luishutterli/", label: "LinkedIn", external: true },
  { href: "mailto:luis@luishutterli.ch", label: "luis@luishutterli.ch", external: false },
];
---

<footer class="bg-ink text-paper">
  <div class="mx-auto px-4 lg:px-6 py-12 max-w-6xl">
    <div class="gap-10 grid grid-cols-1 md:grid-cols-4">
      <div class="md:col-span-2">
        <p class="font-semibold text-xl tracking-tight">Luis Hutterli</p>
        <p class="mt-1 text-zinc-300">Angehender Applikationsentwickler EFZ</p>
        <p class="mt-3 max-w-md text-zinc-400 leading-relaxed">
          Spezialisiert auf Backend-Entwicklung und Full-Stack-Projekte.
        </p>
      </div>

      <div>
        <h2 class="font-medium text-zinc-400 text-sm">Seiten</h2>
        <ul class="space-y-2 mt-3">
          <li><a href="/" class="text-zinc-200 hover:text-paper hover:underline">Home</a></li>
          <li><a href="/projects" class="text-zinc-200 hover:text-paper hover:underline">Projekte</a></li>
        </ul>
      </div>

      <div>
        <h2 class="font-medium text-zinc-400 text-sm">Kontakt</h2>
        <ul class="space-y-2 mt-3">
          {contactLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-zinc-200 hover:text-paper hover:underline"
                {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="flex md:flex-row flex-col justify-between gap-2 mt-10 pt-6 border-zinc-800 border-t text-zinc-400 text-sm">
      <p>&copy; <span data-year>{currentYear}</span> Luis Hutterli. Alle Rechte vorbehalten.</p>
      <p>Kreuzlingen, Schweiz · Verfügbar</p>
    </div>
  </div>
</footer>

<script>
  document.addEventListener("astro:page-load", () => {
    const year = String(new Date().getFullYear());
    for (const el of document.querySelectorAll("[data-year]")) el.textContent = year;
  });
</script>
