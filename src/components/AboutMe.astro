---
const BIRTH_DATE = "2007-04-21";
const START_AGE = 11;

function calcAge(now = new Date()) {
  const birth = new Date(BIRTH_DATE);
  let years = now.getUTCFullYear() - birth.getUTCFullYear();
  const beforeBirthday =
    now.getUTCMonth() < birth.getUTCMonth() ||
    (now.getUTCMonth() === birth.getUTCMonth() && now.getUTCDate() < birth.getUTCDate());
  if (beforeBirthday) years--;
  return years;
}

const age = calcAge();
const experienceYears = age - START_AGE;
const terminalConfig = {
  command: "whoami",
  responses: [
    `Luis Hutterli - ${age} Jahre alt, Kreuzlingen - Schweiz`,
    `Programmierer mit ${experienceYears}+ Jahren Erfahrung`,
    "Spezialisiert auf Backend-Entwicklung",
  ],
  speeds: {
    command: 100,
    typing: 40,
    deleting: 20,
    pauseAfterType: 1000,
    pauseAfterDelete: 300,
    initialDelay: 1000,
  },
};
---

<section class="border-line border-b">
  <div class="mx-auto px-4 lg:px-6 py-14 lg:py-20 max-w-6xl">
    <h2 class="font-semibold text-ink text-3xl lg:text-4xl tracking-tight">Über mich</h2>

    <div class="mt-10 max-w-3xl" data-terminal={JSON.stringify(terminalConfig)}>
      <div class="bg-slate-900 rounded-lg overflow-hidden">
        <div class="flex items-center gap-2 bg-slate-800 px-4 py-3">
          <div class="flex gap-2">
            <div class="bg-red-500 rounded-full w-3 h-3"></div>
            <div class="bg-yellow-500 rounded-full w-3 h-3"></div>
            <div class="bg-green-500 rounded-full w-3 h-3"></div>
          </div>
          <div class="ml-4 font-mono text-slate-400 text-sm">
            bash
          </div>
        </div>

        <div class="p-6 font-mono text-sm">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-green-400">luis@portfolio</span>
            <span class="text-slate-400">:</span>
            <span class="text-blue-400">~</span>
            <span class="text-slate-400">$</span>
            <span class="text-white" id="command"></span>
          </div>
          <div class="text-slate-400">
            <span class="block min-h-[2.4em] text-slate-300 leading-[1.2em]" id="response"></span>
          </div>
        </div>
      </div>
    </div>

    <div class="gap-12 lg:gap-16 grid lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] mt-14">
      <div class="max-w-[65ch]">
        <h3 class="font-semibold text-ink text-xl">Meine Geschichte</h3>
        <div class="space-y-4 mt-4 text-ink-soft text-lg leading-relaxed">
          <p>
            Ich entdeckte meine Leidenschaft für die Informatik schon <strong class="font-semibold text-ink">im Alter von 11 Jahren</strong>,
            als ich auf dem Laptop von meinem Vater meine ersten HTML-Seiten kreierte.
            Mein Interesse für Technologie wurde geweckt und ich wollte meinen eigenen Computer haben.
          </p>
          <p>
            Nach dem erfolgreichen Bau von meinem ersten PC wunderte ich mich, was man denn alles damit machen kann, und entdeckte die
            Minecraft-Plugin-Entwicklung mit <strong class="font-semibold text-ink">Java</strong>. Ich konnte mich mit der Zeit immer besser mit Java vertraut machen
            und begann bald Programme ausserhalb der Minecraft-Welt zu entwickeln.
          </p>
          <p>
            Heute habe ich mehr als {experienceYears} Jahre Erfahrung als
            angehender Applikationsentwickler und probiere laufend
            neue Technologien aus. <strong class="font-semibold text-ink">Wobei ich Java treu geblieben bin!</strong>
          </p>
        </div>
      </div>

      <div>
        <h3 class="font-semibold text-ink text-xl">Auf einen Blick</h3>
        <dl class="mt-4 border-line border-t">
          <div class="flex justify-between gap-6 py-3 border-line border-b">
            <dt class="text-muted">Alter</dt>
            <dd class="font-medium text-ink text-right">{age} Jahre</dd>
          </div>
          <div class="flex justify-between gap-6 py-3 border-line border-b">
            <dt class="text-muted">Erfahrung</dt>
            <dd class="font-medium text-ink text-right">{experienceYears}+ Jahre</dd>
          </div>
          <div class="flex justify-between gap-6 py-3 border-line border-b">
            <dt class="text-muted">Standort</dt>
            <dd class="font-medium text-ink text-right">Kreuzlingen, Schweiz</dd>
          </div>
          <div class="flex justify-between gap-6 py-3 border-line border-b">
            <dt class="text-muted">Fokus</dt>
            <dd class="font-medium text-ink text-right">Backend, DBs & Fullstack</dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>

<script>
  interface TerminalConfig {
    command: string;
    responses: string[];
    speeds: {
      command: number;
      typing: number;
      deleting: number;
      pauseAfterType: number;
      pauseAfterDelete: number;
      initialDelay: number;
    };
  }

  let timer: number | undefined;

  function startTerminal() {
    const root = document.querySelector<HTMLElement>("[data-terminal]");
    const commandElement = document.getElementById("command");
    const responseElement = document.getElementById("response");
    if (!root?.dataset.terminal || !commandElement || !responseElement) return;

    const config: TerminalConfig = JSON.parse(root.dataset.terminal);
    const { command, responses, speeds } = config;

    let commandIndex = 0;
    let responseIndex = 0;
    let currentResponseIndex = 0;
    let isDeleting = false;

    const later = (fn: () => void, ms: number) => {
      timer = window.setTimeout(fn, ms);
    };

    function typeCommand() {
      if (commandIndex < command.length) {
        commandElement!.textContent += command.charAt(commandIndex);
        commandIndex++;
        later(typeCommand, speeds.command);
      } else {
        later(typeResponse, speeds.pauseAfterType);
      }
    }

    function typeResponse() {
      const currentResponse = responses[currentResponseIndex];

      if (!isDeleting && responseIndex < currentResponse.length) {
        responseElement!.textContent += currentResponse.charAt(responseIndex);
        responseIndex++;
        later(typeResponse, speeds.typing);
      } else if (!isDeleting) {
        later(() => {
          isDeleting = true;
          typeResponse();
        }, speeds.pauseAfterType);
      } else if (responseIndex > 0) {
        responseElement!.textContent = currentResponse.substring(0, responseIndex - 1);
        responseIndex--;
        later(typeResponse, speeds.deleting);
      } else {
        isDeleting = false;
        currentResponseIndex = (currentResponseIndex + 1) % responses.length;
        later(typeResponse, speeds.pauseAfterDelete);
      }
    }

    later(typeCommand, speeds.initialDelay);
  }

  document.addEventListener("astro:before-swap", () => window.clearTimeout(timer));
  document.addEventListener("astro:page-load", startTerminal);
</script>
