---
const BIRTH_DATE = "2007-04-21";
const START_AGE = 11;

function calcAge(now = new Date()) {
  const birth = new Date(BIRTH_DATE);
  let years = now.getUTCFullYear() - birth.getUTCFullYear();
  const beforeBirthday =
    now.getUTCMonth() < birth.getUTCMonth() ||
    (now.getUTCMonth() === birth.getUTCMonth() && now.getUTCDate() < birth.getUTCDate());
  if (beforeBirthday) years--;
  return years;
}

const age = calcAge();
const experienceYears = age - START_AGE;
const terminalConfig = {
  command: "whoami",
  responses: [
    `Luis Hutterli - ${age} Jahre alt, Kreuzlingen - Schweiz`,
    `Programmierer mit ${experienceYears}+ Jahren Erfahrung`,
    "Spezialisiert auf Backend-Entwicklung",
  ],
  speeds: {
    command: 100,
    typing: 40,
    deleting: 20,
    pauseAfterType: 1000,
    pauseAfterDelete: 300,
    initialDelay: 1000,
  },
};
---

<section class="relative py-12 text-gray-800">
  <div class="mx-auto px-8 container">
    <div class="mb-4 text-center">
      <h2 class="bg-clip-text bg-linear-to-r from-neutral-dark via-primary to-secondary mb-2 font-bold text-transparent text-3xl lg:text-4xl">
        Über mich
      </h2>
    </div>

    <div class="mx-auto mb-4 max-w-3xl" data-terminal={JSON.stringify(terminalConfig)}>
      <div class="bg-slate-900 shadow-2xl rounded-lg overflow-hidden">
        <div class="flex items-center gap-2 bg-slate-800 px-4 py-3">
          <div class="flex gap-2">
            <div class="bg-red-500 rounded-full w-3 h-3"></div>
            <div class="bg-yellow-500 rounded-full w-3 h-3"></div>
            <div class="bg-green-500 rounded-full w-3 h-3"></div>
          </div>
          <div class="ml-4 font-mono text-slate-400 text-sm">
            bash
          </div>
        </div>
        
        <div class="p-6 font-mono text-sm">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-green-400">luis@portfolio</span>
            <span class="text-neutral-light">:</span>
            <span class="text-blue-400">~</span>
            <span class="text-neutral-light">$</span>
            <span class="text-white" id="command"></span>
          </div>
          <div class="text-neutral-light">
            <span class="block min-h-[2.4em] text-neutral-light leading-[1.2em]" id="response"></span>
          </div>
        </div>
      </div>
    </div>

    <div class="mx-auto max-w-4xl">
      <div class="items-center gap-6 grid md:grid-cols-2">
          <div class="space-y-2">
            <h3 class="font-semibold text-primary text-xl">Meine Geschichte</h3>
            <p class="text-neutral leading-relaxed">
              Ich entdeckte meine Leidenschaft für die Informatik schon <strong class="text-primary">im Alter von 11 Jahren</strong>, 
              als ich auf dem Laptop von meinem Vater meine ersten <strong class="text-orange-600">HTML-Seiten</strong> kreierte.
              Mein Interesse für Technologie wurde geweckt und ich wollte meinen eigenen Computer haben.
            </p>
            <p class="text-neutral leading-relaxed">
              Nach dem erfolgreichen Bau von meinem ersten PC wunderte ich mich, was man denn alles damit machen kann, und entdeckte die
              <strong class="text-emerald-600">Minecraft-Plugin-Entwicklung</strong> 
              mit <strong class="text-amber-700">Java</strong>. Ich konnte mich mit der Zeit immer besser mit Java vertraut machen
              und begann bald Programme ausserhalb der Minecraft-Welt zu entwickeln.
            </p>
            <p class="text-neutral leading-relaxed">
              Heute habe ich <strong class="text-primary">mehr als {experienceYears} Jahre Erfahrung</strong> als 
              <strong class="text-secondary">angehender Applikationsentwickler</strong> und probiere laufend 
              neue Technologien aus. <strong class="text-yellow-500">Wobei ich Java treu geblieben bin!</strong>
            </p>
          </div>

        <div>
          <div class="bg-white/70 shadow-lg backdrop-blur-sm p-4 rounded-xl">
            <h4 class="mb-3 font-semibold text-neutral-dark text-center">Auf einen Blick</h4>
            <div class="space-y-2">
              <div class="flex justify-between items-center">
                <span class="text-neutral">Alter</span>
                <span class="font-semibold text-primary">{age} Jahre</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-neutral">Erfahrung</span>
                <span class="font-semibold text-secondary">{experienceYears}+ Jahre</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-neutral">Standort</span>
                <span class="font-semibold text-accent">Kreuzlingen, Schweiz</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-neutral">Fokus</span>
                <span class="font-semibold text-neutral-dark">Backend, DBs & Fullstack</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  interface TerminalConfig {
    command: string;
    responses: string[];
    speeds: {
      command: number;
      typing: number;
      deleting: number;
      pauseAfterType: number;
      pauseAfterDelete: number;
      initialDelay: number;
    };
  }

  let timer: number | undefined;

  function startTerminal() {
    const root = document.querySelector<HTMLElement>("[data-terminal]");
    const commandElement = document.getElementById("command");
    const responseElement = document.getElementById("response");
    if (!root?.dataset.terminal || !commandElement || !responseElement) return;

    const config: TerminalConfig = JSON.parse(root.dataset.terminal);
    const { command, responses, speeds } = config;

    let commandIndex = 0;
    let responseIndex = 0;
    let currentResponseIndex = 0;
    let isDeleting = false;

    const later = (fn: () => void, ms: number) => {
      timer = window.setTimeout(fn, ms);
    };

    function typeCommand() {
      if (commandIndex < command.length) {
        commandElement!.textContent += command.charAt(commandIndex);
        commandIndex++;
        later(typeCommand, speeds.command);
      } else {
        later(typeResponse, speeds.pauseAfterType);
      }
    }

    function typeResponse() {
      const currentResponse = responses[currentResponseIndex];

      if (!isDeleting && responseIndex < currentResponse.length) {
        responseElement!.textContent += currentResponse.charAt(responseIndex);
        responseIndex++;
        later(typeResponse, speeds.typing);
      } else if (!isDeleting) {
        later(() => {
          isDeleting = true;
          typeResponse();
        }, speeds.pauseAfterType);
      } else if (responseIndex > 0) {
        responseElement!.textContent = currentResponse.substring(0, responseIndex - 1);
        responseIndex--;
        later(typeResponse, speeds.deleting);
      } else {
        isDeleting = false;
        currentResponseIndex = (currentResponseIndex + 1) % responses.length;
        later(typeResponse, speeds.pauseAfterDelete);
      }
    }

    later(typeCommand, speeds.initialDelay);
  }

  document.addEventListener("astro:before-swap", () => window.clearTimeout(timer));
  document.addEventListener("astro:page-load", startTerminal);
</script>
