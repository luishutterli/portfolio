---
import { Icon } from "astro-icon/components";
---

<section class="border-line border-b">
  <div class="mx-auto px-4 lg:px-6 pt-14 lg:pt-28 pb-12 lg:pb-20 max-w-6xl">
    <h1
      class="font-semibold text-ink text-5xl lg:text-7xl tracking-[-0.03em]"
      transition:name="hero-title"
    >
      Luis Hutterli
    </h1>
    <p class="mt-4 font-medium text-ink-soft text-xl lg:text-2xl">
      Angehender Applikationsentwickler EFZ
    </p>
    <p class="mt-6 max-w-[52ch] text-muted text-lg leading-relaxed">
      Leidenschaftlich für moderne Technologien. Auf dem Weg zum Applikationsentwickler mit Fokus auf Backend-Entwicklung.
    </p>
    <a
      href="/projects"
      class="group inline-flex items-center gap-2 bg-ink hover:bg-accent mt-10 px-6 py-3 rounded-md font-medium text-paper transition-colors"
      transition:name="hero-cta"
    >
      Projekte ansehen
      <Icon name="lucide:arrow-right" class="w-4 h-4 transition-transform group-hover:translate-x-0.5" />
    </a>
  </div>
</section>
