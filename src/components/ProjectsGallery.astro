---
import { Icon } from "astro-icon/components";
import { getSortedProjects } from "../lib/projects";
import ProjectCard from "./ProjectCard.astro";

const sortedProjects = await getSortedProjects();

const featuredProjects = sortedProjects.slice(0, 6);
---

<section>
  <div class="mx-auto px-4 lg:px-6 py-14 lg:py-20 max-w-6xl">
    <div class="flex sm:flex-row flex-col justify-between sm:items-end gap-4">
      <div>
        <h2
          class="font-semibold text-ink text-3xl lg:text-4xl tracking-tight"
          transition:name="projects-heading"
        >
          Meine Projekte
        </h2>
        <p class="mt-3 text-muted text-lg">Eine Auswahl meiner neuesten Arbeiten.</p>
      </div>
      <a
        href="/projects"
        class="group inline-flex items-center gap-1.5 font-medium text-accent hover:text-accent-hover underline-offset-4 hover:underline"
        transition:name="view-all-projects"
      >
        Alle Projekte ansehen
        <Icon name="lucide:arrow-right" class="w-4 h-4 transition-transform group-hover:translate-x-0.5" />
      </a>
    </div>

    <div class="gap-x-8 gap-y-14 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 mt-12">
      {featuredProjects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </div>
</section>
