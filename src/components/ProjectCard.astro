---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import { splitLinkTitle } from "../lib/projects";

interface Props {
  project: CollectionEntry<"projects">;
  showImage?: boolean;
  showFullDescription?: boolean;
  headingLevel?: "h2" | "h3";
}

const {
  project,
  showImage = true,
  showFullDescription = false,
  headingLevel = "h3",
} = Astro.props;
const Heading = headingLevel;
const shortName = project.data.name.split(" | ")[0];
const visibleTags = project.data.tags.slice(0, 4);
const hiddenTagCount = project.data.tags.length - visibleTags.length;
const MAX_DESCRIPTION = 200;
const description =
  !showFullDescription && project.data.description.length > MAX_DESCRIPTION
    ? `${project.data.description.slice(0, MAX_DESCRIPTION).replace(/\s+\S*$/, "")}…`
    : project.data.description;
const primaryLink = project.data.links[0] && {
  url: project.data.links[0].url,
  ...splitLinkTitle(project.data.links[0].title),
};
const hasLinks = Boolean(project.data.github || primaryLink);
---

<article class="group relative flex flex-col h-full">
  {
    showImage && project.data.image && (
      <div class="bg-paper-2 mb-5 border border-line rounded-md aspect-video overflow-hidden">
        <Image
          src={project.data.image}
          alt=""
          widths={[400, 800, 1200]}
          sizes="(min-width: 1280px) 363px, (min-width: 1024px) calc((100vw - 7rem) / 3), (min-width: 768px) calc((100vw - 4rem) / 2), calc(100vw - 2rem)"
          loading="lazy"
          class="w-full h-full object-cover"
          transition:name={`project-image-${project.id}`}
        />
      </div>
    )
  }
  {
    showImage && !project.data.image && (
      <div
        class="flex items-end bg-paper-2 mb-5 p-5 border border-line rounded-md aspect-video overflow-hidden"
        aria-hidden="true"
      >
        <p class="font-semibold text-ink-soft text-2xl wrap-break-word text-balance leading-tight tracking-tight">
          {shortName}
        </p>
      </div>
    )
  }

  <div class="flex justify-between items-baseline gap-4">
    <Heading class="font-semibold text-ink text-xl leading-snug tracking-tight">
      <a
        href={`/projects/${project.id}`}
        class="after:absolute after:inset-0 group-hover:text-accent transition-colors"
        transition:name={`project-title-${project.id}`}
      >
        {project.data.name}
      </a>
    </Heading>
    <span class="text-muted text-sm shrink-0">{project.data.state}</span>
  </div>

  <p class="mt-2 text-ink-soft leading-relaxed">{description}</p>

  <p class="mt-3 text-muted text-sm">
    {visibleTags.join(" · ")}{hiddenTagCount > 0 && ` · +${hiddenTagCount}`}
  </p>

  {
    hasLinks && (
      <div class="z-10 relative flex flex-wrap items-center gap-x-5 gap-y-1 mt-auto pt-4 text-sm">
        {project.data.github && (
          <a
            href={project.data.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 -my-1 py-2 font-medium text-ink hover:text-accent transition-colors"
          >
            <Icon name="simple-icons:github" class="w-3.5 h-3.5" />
            Code
          </a>
        )}
        {primaryLink && (
          <a
            href={primaryLink.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 -my-1 py-2 font-medium text-ink hover:text-accent transition-colors"
          >
            {primaryLink.label}
            <Icon name="lucide:arrow-up-right" class="w-3.5 h-3.5" />
          </a>
        )}
        {primaryLink?.note && <span class="text-muted">{primaryLink.note}</span>}
      </div>
    )
  }
</article>
