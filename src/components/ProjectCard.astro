---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  showImage?: boolean;
  showFullDescription?: boolean;
  headingLevel?: "h2" | "h3";
}

const {
  project,
  showImage = true,
  showFullDescription = false,
  headingLevel = "h3",
} = Astro.props;
const Heading = headingLevel;
const visibleTags = project.data.tags.slice(0, 4);
const hiddenTagCount = project.data.tags.length - visibleTags.length;
const description =
  !showFullDescription && project.data.description.length > 200
    ? `${project.data.description.substring(0, 200)}...`
    : project.data.description;
---

<article class="group relative flex flex-col h-full">
  {
    showImage && project.data.image && (
      <div class="bg-paper-2 mb-5 border border-line rounded-md aspect-video overflow-hidden">
        <Image
          src={project.data.image}
          alt=""
          widths={[400, 800, 1200]}
          sizes="(min-width: 1280px) 384px, (min-width: 768px) 50vw, 100vw"
          loading="lazy"
          class="w-full h-full object-cover"
          transition:name={`project-image-${project.id}`}
        />
      </div>
    )
  }

  <div class="flex justify-between items-baseline gap-4">
    <Heading class="font-semibold text-ink text-xl leading-snug tracking-tight">
      <a
        href={`/projects/${project.id}`}
        class="group-hover:text-accent transition-colors after:absolute after:inset-0"
        transition:name={`project-title-${project.id}`}
      >
        {project.data.name}
      </a>
    </Heading>
    <span class="shrink-0 text-muted text-sm">{project.data.state}</span>
  </div>

  <p class="mt-2 text-ink-soft leading-relaxed">{description}</p>

  <p class="mt-3 text-muted text-sm">
    {visibleTags.join(" · ")}{hiddenTagCount > 0 && ` · +${hiddenTagCount}`}
  </p>
</article>
