---
import { getCollection } from "astro:content";
import { skillGroups } from "../data/skills.ts";

const projects = await getCollection("projects");
const projectLabels = new Map(projects.map((p) => [p.id, p.data.name.split(" | ")[0]]));

for (const group of skillGroups) {
  for (const tech of group.technologies) {
    for (const slug of tech.usedIn) {
      if (!projectLabels.has(slug))
        throw new Error(`skills.ts: unknown project "${slug}" for ${tech.name}`);
    }
  }
}
---

<section>
  <div class="mx-auto px-4 lg:px-6 py-14 lg:py-20 max-w-6xl">
    <h2 class="font-semibold text-ink text-3xl lg:text-4xl tracking-tight">Womit ich arbeite</h2>
    <p class="mt-3 max-w-[60ch] text-muted text-lg leading-relaxed">
      Jeweils verlinkt ist das Projekt, in dem ich die Technologie eingesetzt habe.
    </p>

    <div class="gap-x-16 gap-y-12 grid lg:grid-cols-2 mt-12">
      {skillGroups.map((group) => (
        <div>
          <h3 class="pb-3 border-ink border-b font-semibold text-ink text-lg">{group.title}</h3>
          <dl>
            {group.technologies.map((tech) => (
              <div class="sm:flex sm:justify-between sm:gap-6 py-3 border-line border-b">
                <dt class="font-medium text-ink">{tech.name}</dt>
                <dd class="mt-1 sm:mt-0 text-muted sm:text-right">
                  {tech.usedIn.map((slug, index) => (
                    <>{index > 0 && ", "}<a href={`/projects/${slug}`} class="hover:text-accent underline decoration-ink/25 underline-offset-2 hover:decoration-accent">{projectLabels.get(slug)}</a></>
                  ))}
                </dd>
              </div>
            ))}
          </dl>
          {group.other.length > 0 && (
            <p class="mt-4 text-muted text-sm leading-relaxed">
              <span class="font-medium text-ink-soft">Ausserdem:</span> {group.other.join(", ")}
            </p>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
