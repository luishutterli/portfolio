---
const currentPath = Astro.url.pathname;

const links = [
  { href: "/", label: "Home", active: currentPath === "/", transitionName: "nav-home" },
  {
    href: "/projects",
    label: "Projekte",
    active: currentPath.startsWith("/projects"),
    transitionName: "nav-projects",
  },
];
---

<nav class="top-0 z-50 sticky bg-paper/95 border-line border-b">
  <div class="mx-auto px-4 lg:px-6 max-w-6xl">
    <div class="flex justify-between items-center h-16">
      <a
        href="/"
        class="font-semibold text-ink hover:text-accent text-lg tracking-tight transition-colors"
        transition:name="nav-logo"
      >
        Luis Hutterli
      </a>

      <div class="flex items-center gap-6">
        {links.map((link) => (
          <a
            href={link.href}
            aria-current={link.active ? "page" : undefined}
            class={`py-2 text-sm font-medium transition-colors ${
              link.active
                ? "text-ink underline decoration-accent decoration-2 underline-offset-8"
                : "text-muted hover:text-ink"
            }`}
            transition:name={link.transitionName}
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</nav>
