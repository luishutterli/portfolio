---
import { Image } from "astro:assets";
import { type CollectionEntry, getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/Layout.astro";
import { formatDate } from "../../lib/projects";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout
  title={project.data.name}
  description={project.data.description}
  image={project.data.image}
>
  <article class="mx-auto px-4 lg:px-6 pt-8 pb-20 max-w-6xl">
    <a
      href="/projects"
      class="group inline-flex items-center gap-1.5 font-medium text-muted hover:text-ink text-sm"
    >
      <Icon name="lucide:chevron-left" class="w-4 h-4 transition-transform group-hover:-translate-x-0.5" />
      Zurück zu allen Projekten
    </a>

    {project.data.image && (
      <div class="bg-paper-2 mt-6 border border-line rounded-md overflow-hidden">
        <Image
          src={project.data.image}
          alt=""
          widths={[640, 1024, 1536]}
          sizes="(min-width: 1152px) 1144px, 100vw"
          loading="eager"
          fetchpriority="high"
          class="w-full object-cover aspect-video"
          transition:name={`project-image-${project.id}`}
        />
      </div>
    )}

    <header class="mx-auto mt-10 max-w-[68ch]">
      <h1 class="font-semibold text-ink text-4xl lg:text-5xl tracking-tight text-balance" transition:name={`project-title-${project.id}`}>
        {project.data.name}
      </h1>
      <p class="mt-4 text-ink-soft text-xl leading-relaxed">
        {project.data.description}
      </p>
      <p class="mt-4 text-muted text-sm">
        {project.data.state} · {project.data.tags.slice(0, 3).join(" · ")}
        {project.data.tags.length > 3 && (
          <>
            {" · "}
            <a href="#technologies-used-list" class="hover:text-ink underline">
              +{project.data.tags.length - 3} mehr
            </a>
          </>
        )}
      </p>
    </header>

    <div class="mx-auto mt-12 pt-10 border-line border-t max-w-[68ch] prose prose-slate prose-lg prose-a:text-accent prose-headings:tracking-tight prose-code:bg-paper-2 prose-code:px-1 prose-code:py-0.5 prose-code:rounded prose-code:before:content-none prose-code:after:content-none [&>h1:first-child]:hidden">
      <Content />
    </div>

    <div class="gap-10 grid md:grid-cols-3 mx-auto mt-16 pt-10 border-line border-t max-w-[68ch] md:max-w-none">
      <div id="technologies-used-list">
        <h2 class="font-semibold text-ink">Technologien</h2>
        <p class="mt-3 text-ink-soft leading-relaxed">{project.data.tags.join(" · ")}</p>
      </div>

      <div>
        <h2 class="font-semibold text-ink">Links</h2>
        <ul class="space-y-2 mt-3">
          {project.data.github && (
            <li>
              <a href={project.data.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-accent hover:text-accent-hover hover:underline">
                <Icon name="simple-icons:github" class="w-4 h-4" />
                GitHub
              </a>
            </li>
          )}
          {project.data.links.map((link) => (
            <li>
              <a href={link.url} target="_blank" rel="noopener noreferrer" class="text-accent hover:text-accent-hover hover:underline">
                {link.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {(project.data.startDate || project.data.endDate) && (
        <div>
          <h2 class="font-semibold text-ink">Timeline</h2>
          <dl class="space-y-2 mt-3">
            {project.data.startDate && (
              <div class="flex gap-3">
                <dt class="w-28 text-muted">Gestartet</dt>
                <dd class="tabular-nums text-ink-soft">{formatDate(project.data.startDate)}</dd>
              </div>
            )}
            {project.data.endDate && (
              <div class="flex gap-3">
                <dt class="w-28 text-muted">Abgeschlossen</dt>
                <dd class="tabular-nums text-ink-soft">{formatDate(project.data.endDate)}</dd>
              </div>
            )}
          </dl>
        </div>
      )}
    </div>
  </article>
</Layout>
