---
import { Image } from "astro:assets";
import { type CollectionEntry, getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/Layout.astro";
import { formatPeriod, splitLinkTitle, warnAboutCover } from "../../lib/projects";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  projects.forEach(warnAboutCover);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { Content } = await render(project);
const period = formatPeriod(project.data.startDate, project.data.endDate);
const links = project.data.links.map((link) => ({
  url: link.url,
  ...splitLinkTitle(link.title),
}));
const hasLinks = Boolean(project.data.github || links.length > 0);
---

<Layout
  title={project.data.name}
  description={project.data.description}
  image={project.data.image}
>
  <article class="mx-auto px-4 lg:px-6 pt-8 pb-20 max-w-6xl">
    <a
      href="/projects"
      class="group inline-flex items-center gap-1.5 py-1 font-medium text-muted hover:text-ink text-sm"
    >
      <Icon name="lucide:chevron-left" class="w-4 h-4 transition-transform group-hover:-translate-x-0.5" />
      Zurück zu allen Projekten
    </a>

    <div class="gap-x-16 gap-y-10 grid grid-cols-[minmax(0,1fr)] lg:grid-cols-[minmax(0,1fr)_20rem] mt-8 lg:mt-12">
      <header class="lg:col-start-1">
        <h1
          class="font-semibold text-ink text-4xl lg:text-5xl break-words text-balance tracking-tight hyphens-auto"
          transition:name={`project-title-${project.id}`}
        >
          {project.data.name}
        </h1>
        <p class="mt-5 max-w-[60ch] text-ink-soft text-xl break-words leading-relaxed hyphens-auto">
          {project.data.description}
        </p>

        {hasLinks && (
          <div class="flex flex-wrap items-center gap-x-6 gap-y-3 mt-8">
            {project.data.github && (
              <a
                href={project.data.github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 bg-ink hover:bg-accent px-5 py-2.5 rounded-md font-medium text-paper transition-colors"
              >
                <Icon name="simple-icons:github" class="w-4 h-4" />
                Code auf GitHub
              </a>
            )}
            {links.map((link) => (
              <span class="inline-flex flex-wrap items-baseline gap-x-2 max-w-full">
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 py-2.5 font-medium text-ink hover:text-accent transition-colors"
                >
                  {link.label}
                  <Icon name="lucide:arrow-up-right" class="w-4 h-4" />
                </a>
                {link.note && <span class="min-w-0 text-muted text-sm break-words">{link.note}</span>}
              </span>
            ))}
          </div>
        )}
      </header>

      <dl class="lg:top-24 lg:sticky self-start lg:col-start-2 lg:row-span-3 lg:row-start-1 border-ink border-t lg:max-h-[calc(100vh-8rem)] lg:overflow-y-auto text-sm break-words">
        <div class="py-3 border-line border-b">
          <dt class="text-muted">Status</dt>
          <dd class="mt-1 font-medium text-ink">{project.data.state}</dd>
        </div>
        {period && (
          <div class="py-3 border-line border-b">
            <dt class="text-muted">Zeitraum</dt>
            <dd class="mt-1 font-medium text-ink">{period}</dd>
          </div>
        )}
        {project.data.tags.length > 0 && (
          <div class="py-3 border-line border-b">
            <dt class="text-muted">Technologien</dt>
            <dd class="mt-1 text-ink leading-relaxed">{project.data.tags.join(" · ")}</dd>
          </div>
        )}
      </dl>

    {project.data.image && (
      <div class="lg:col-start-1 bg-paper-2 border border-line rounded-md overflow-hidden">
        <Image
          src={project.data.image}
          alt=""
          widths={[640, 896, 1280, 1792]}
          sizes="(min-width: 1280px) 720px, (min-width: 1024px) calc(100vw - 3rem - 24rem), calc(100vw - 2rem)"
          loading="eager"
          fetchpriority="high"
          class="w-full object-contain aspect-video"
          transition:name={`project-image-${project.id}`}
        />
      </div>
    )}

    <div
      class:list={[
        "lg:col-start-1 mt-4 max-w-[68ch] wrap-break-word prose prose-slate prose-lg prose-a:text-accent prose-headings:tracking-tight prose-code:bg-paper-2 prose-code:px-1 prose-code:py-0.5 prose-code:rounded prose-code:before:content-none prose-code:after:content-none [&>h1:first-child]:hidden",
        !project.data.image && "pt-10 border-line border-t",
      ]}
    >
      <Content />
    </div>
    </div>
  </article>
</Layout>
